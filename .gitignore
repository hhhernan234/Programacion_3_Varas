dist/
build/
.next/
out/
coverage/
**/dist/
**/build/
**/.next/
**/out/
**/coverage/

########################################
# Logs
########################################
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
**/logs/

########################################
